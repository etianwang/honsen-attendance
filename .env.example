DATABASE_URL=postgresql+psycopg://attendance:attendance@localhost:5433/attendance
SECRET_KEY=change-me-to-a-random-secret

UPLOAD_DIR=uploads

# Google Drive — alternative backend, not required if using COS below. See
# README if you want to switch to this instead (needs a one-time login via
# scripts/gdrive_oauth_setup.py — a service account can't be used).
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET_PATH=
GOOGLE_DRIVE_OAUTH_TOKEN_PATH=secrets/gdrive-token.json
GOOGLE_DRIVE_FOLDER_ID=

# Tencent COS — daily team photos sync here once all four are set. Leave
# blank to keep photos local-only (they still save fine, just marked
# "pending" until configured).
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
